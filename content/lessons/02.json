  },
  "stories": [
    {
      "id": "1",
      "label": "第一则",
      "title": "这是什么",
      "scene": "佐藤的桌上放着几样东西。他指给你看，问你认不认识。",
      "lines": [
        {
          "id": "01",
          "speaker": "佐藤",
          "parts": [{ "t": "これ" }, { "t": "は" }, { "t": "何", "r": "なん" }, { "t": "ですか" }, { "t": "。" }],
          "speech": "これはなんですか。",
          "zh": "这是什么？",
          "audio": "01.mp3"
        },
        {
          "id": "02",
          "speaker": "周",
          "parts": [{ "t": "本", "r": "ほん" }, { "t": "ですか" }, { "t": "。" }],
          "speech": "ほんですか。",
          "zh": "是书吗？",
          "audio": "02.mp3"
        },
        {
          "id": "03",
          "speaker": "佐藤",
          "parts": [{ "t": "はい" }, { "t": "、" }, { "t": "本", "r": "ほん" }, { "t": "です" }, { "t": "。" }, { "t": "それ" }, { "t": "は" }, { "t": "ノート" }, { "t": "です" }, { "t": "。" }],
          "speech": "はい、ほんです。それはノートです。",
          "zh": "是，是书。那是笔记本。",
          "audio": "03.mp3"
        },
        {
          "id": "04",
          "speaker": "周",
          "parts": [{ "t": "あれ" }, { "t": "は" }, { "t": "何", "r": "なん" }, { "t": "ですか" }, { "t": "。" }],
          "speech": "あれはなんですか。",
          "zh": "那是什么？",
          "audio": "04.mp3"
        },
        {
          "id": "05",
          "speaker": "佐藤",
          "parts": [{ "t": "あれ" }, { "t": "は" }, { "t": "傘", "r": "かさ" }, { "t": "です" }, { "t": "。" }],
          "speech": "あれはかさです。",
          "zh": "那是伞。",
          "audio": "05.mp3"
        }
      ],
      "grammar": [
        {
          "pattern": "これは何ですか",
          "zh": "これ是离说话人近的东西。问「是什么」时，何读なん。",
          "example": [{ "t": "これ" }, { "t": "は" }, { "t": "何", "r": "なん" }, { "t": "ですか" }, { "t": "。" }]
        },
        {
          "pattern": "それ / あれ",
          "zh": "それ离听的人近。あれ离两个人都远。",
          "example": [{ "t": "あれ" }, { "t": "は" }, { "t": "傘", "r": "かさ" }, { "t": "です" }, { "t": "。" }]
        }
      ],
      "words": [
        { "parts": [{ "t": "これ" }], "zh": "这个（离我近）" },
        { "parts": [{ "t": "それ" }], "zh": "那个（离你近）" },
        { "parts": [{ "t": "あれ" }], "zh": "那个（离我们都远）" },
        { "parts": [{ "t": "何", "r": "なん" }], "zh": "什么" },
        { "parts": [{ "t": "本", "r": "ほん" }], "zh": "书" },
        { "parts": [{ "t": "ノート" }], "zh": "笔记本" },
        { "parts": [{ "t": "傘", "r": "かさ" }], "zh": "伞" }
      ]
    },
    {
      "id": "2",
      "label": "第二则",
      "title": "这把伞是谁的",
      "scene": "伞和钟表就在你们手边。佐藤要确认哪一件是谁的。",
      "lines": [
        {
          "id": "06",
          "speaker": "周",
          "parts": [{ "t": "この" }, { "t": "傘", "r": "かさ" }, { "t": "は" }, { "t": "佐藤", "r": "さとう" }, { "t": "さんの" }, { "t": "ですか" }, { "t": "。" }],
          "speech": "このかさはさとうさんのですか。",
          "zh": "这把伞是佐藤的吗？",
          "audio": "06.mp3"
        },
        {
          "id": "07",
          "speaker": "佐藤",
          "parts": [{ "t": "はい" }, { "t": "、" }, { "t": "そう" }, { "t": "です" }, { "t": "。" }, { "t": "私", "r": "わたし" }, { "t": "の" }, { "t": "傘", "r": "かさ" }, { "t": "です" }, { "t": "。" }],
          "speech": "はい、そうです。わたしのかさです。",
          "zh": "是的。是我的伞。",
          "audio": "07.mp3"
        },
        {
          "id": "08",
          "speaker": "周",
          "parts": [{ "t": "その" }, { "t": "時計", "r": "とけい" }, { "t": "は" }, { "t": "田中", "r": "たなか" }, { "t": "さんの" }, { "t": "ですか" }, { "t": "。" }],
          "speech": "そのとけいはたなかさんのですか。",
          "zh": "那个表是田中的吗？",
          "audio": "08.mp3"
        },
        {
          "id": "09",
          "speaker": "佐藤",
          "parts": [{ "t": "いいえ" }, { "t": "、" }, { "t": "そう" }, { "t": "ではありません" }, { "t": "。" }, { "t": "私", "r": "わたし" }, { "t": "の" }, { "t": "時計", "r": "とけい" }, { "t": "です" }, { "t": "。" }],
          "speech": "いいえ、そうではありません。わたしのとけいです。",
          "zh": "不，不是。是我的表。",
          "audio": "09.mp3"
        },
        {
          "id": "10",
          "speaker": "周",
          "parts": [{ "t": "この" }, { "t": "本", "r": "ほん" }, { "t": "も" }, { "t": "佐藤", "r": "さとう" }, { "t": "さんの" }, { "t": "ですか" }, { "t": "。" }],
          "speech": "このほんもさとうさんのですか。",
          "zh": "这本书也是佐藤的吗？",
          "audio": "10.mp3"
        },
        {
          "id": "11",
          "speaker": "佐藤",
          "parts": [{ "t": "はい" }, { "t": "、" }, { "t": "この" }, { "t": "本", "r": "ほん" }, { "t": "も" }, { "t": "私", "r": "わたし" }, { "t": "の" }, { "t": "です" }, { "t": "。" }],
          "speech": "はい、このほんもわたしのです。",
          "zh": "是，这本书也是我的。",
          "audio": "11.mp3"
        }
      ],
      "grammar": [
        {
          "pattern": "この / その / あの + 名词",
          "zh": "后面要接东西的名字。この离我近，その离你近，あの离我们都远。",
          "example": [{ "t": "この" }, { "t": "傘", "r": "かさ" }, { "t": "は" }, { "t": "佐藤", "r": "さとう" }, { "t": "さんの" }, { "t": "です" }, { "t": "。" }]
        },
        {
          "pattern": "そうです / そうではありません",
          "zh": "回答「是不是」时，可以不把东西再说一遍。",
          "example": [{ "t": "はい" }, { "t": "、" }, { "t": "そう" }, { "t": "です" }, { "t": "。" }]
        }
      ],
      "words": [
        { "parts": [{ "t": "この" }], "zh": "这个……" },
        { "parts": [{ "t": "その" }], "zh": "那个……" },
        { "parts": [{ "t": "の" }], "zh": "的" },
        { "parts": [{ "t": "そう" }], "zh": "那样" },
        { "parts": [{ "t": "時計", "r": "とけい" }], "zh": "钟，表" }
      ]
    },
    {
      "id": "3",
      "label": "第三则",
      "title": "那个包是谁的",
      "scene": "门口还有一个包、一把钥匙和一份报纸。你们对一下是谁落下的。",
      "lines": [
        {
          "id": "12",
          "speaker": "佐藤",
          "parts": [{ "t": "あの" }, { "t": "鞄", "r": "かばん" }, { "t": "は" }, { "t": "誰", "r": "だれ" }, { "t": "の" }, { "t": "ですか" }, { "t": "。" }],
          "speech": "あのかばんはだれのですか。",
          "zh": "那个包是谁的？",
          "audio": "12.mp3"
        },
        {
          "id": "13",
          "speaker": "周",
          "parts": [{ "t": "私", "r": "わたし" }, { "t": "の" }, { "t": "鞄", "r": "かばん" }, { "t": "です" }, { "t": "。" }],
          "speech": "わたしのかばんです。",
          "zh": "是我的包。",
          "audio": "13.mp3"
        },
        {
          "id": "14",
          "speaker": "佐藤",
          "parts": [{ "t": "この" }, { "t": "鍵", "r": "かぎ" }, { "t": "も" }, { "t": "周", "r": "しゅう" }, { "t": "さんの" }, { "t": "ですか" }, { "t": "。" }],
          "speech": "このかぎもしゅうさんのですか。",
          "zh": "这把钥匙也是小周的吗？",
          "audio": "14.mp3"
        },
        {
          "id": "15",
          "speaker": "周",
          "parts": [{ "t": "はい" }, { "t": "、" }, { "t": "そう" }, { "t": "です" }, { "t": "。" }],
          "speech": "はい、そうです。",
          "zh": "是的。",
          "audio": "15.mp3"
        },
        {
          "id": "16",
          "speaker": "佐藤",
          "parts": [{ "t": "その" }, { "t": "新聞", "r": "しんぶん" }, { "t": "は" }, { "t": "私", "r": "わたし" }, { "t": "の" }, { "t": "ですか" }, { "t": "。" }],
          "speech": "そのしんぶんはわたしのですか。",
          "zh": "那份报纸是我的吗？",
          "audio": "16.mp3"
        },
        {
          "id": "17",
          "speaker": "周",
          "parts": [{ "t": "いいえ" }, { "t": "、" }, { "t": "そう" }, { "t": "ではありません" }, { "t": "。" }, { "t": "私", "r": "わたし" }, { "t": "の" }, { "t": "新聞", "r": "しんぶん" }, { "t": "です" }, { "t": "。" }],
          "speech": "いいえ、そうではありません。わたしのしんぶんです。",
          "zh": "不，不是。是我的报纸。",
          "audio": "17.mp3"
        }
      ],
      "grammar": [
        {
          "pattern": "誰のですか",
          "zh": "问东西是谁的。谁仍读だれ。",
          "example": [{ "t": "あの" }, { "t": "鞄", "r": "かばん" }, { "t": "は" }, { "t": "誰", "r": "だれ" }, { "t": "の" }, { "t": "ですか" }, { "t": "。" }]
        },
        {
          "pattern": "そうではありません",
          "zh": "否定刚才的猜测，然后再说是谁的。",
          "example": [{ "t": "いいえ" }, { "t": "、" }, { "t": "そう" }, { "t": "ではありません" }, { "t": "。" }]
        }
      ],
      "words": [
        { "parts": [{ "t": "あの" }], "zh": "那个……（都远）" },
        { "parts": [{ "t": "鞄", "r": "かばん" }], "zh": "包" },
        { "parts": [{ "t": "鍵", "r": "かぎ" }], "zh": "钥匙" },
        { "parts": [{ "t": "新聞", "r": "しんぶん" }], "zh": "报纸" },
        { "parts": [{ "t": "誰", "r": "だれ" }], "zh": "谁" }
      ]
    }
  ]
}
