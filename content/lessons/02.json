  "whitelist": [
    "こんにちは", "ではありません", "です", "だれ", "はい", "いいえ", "そう",
    "これ", "それ", "あれ", "この", "その", "あの", "なん", "なに",
    "わたし", "さとう", "しゅう", "たなか", "さとうさん", "しゅうさん", "たなかさん",
    "ほん", "ノート", "かさ", "とけい", "かぎ", "かばん", "しんぶん",
    "さん", "の", "は", "か", "も"
  ],
  "speakers": {
    "佐藤": { "reading": "さとう", "voice": "ja-JP-KeitaNeural" },
