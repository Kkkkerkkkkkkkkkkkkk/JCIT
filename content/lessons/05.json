  "stories": [
    {
      "id": "1",
      "label": "第一则",
      "title": "七点起床",
      "scene": "周一早上，佐藤问你每天几点起床、几点睡觉。",
      "lines": [
        {
          "id": "01",
          "speaker": "佐藤",
          "parts": [{ "t": "周", "r": "しゅう" }, { "t": "さんは" }, { "t": "何時", "r": "なんじ" }, { "t": "に" }, { "t": "起きます", "r": "おきます" }, { "t": "か" }, { "t": "。" }],
          "speech": "しゅうさんはなんじにおきますか。",
          "zh": "小周几点起床？",
          "audio": "01.mp3"
        },
        {
          "id": "02",
          "speaker": "周",
          "parts": [{ "t": "7時", "r": "しちじ" }, { "t": "に" }, { "t": "起きます", "r": "おきます" }, { "t": "。" }],
          "speech": "しちじにおきます。",
          "zh": "七点起床。",
          "audio": "02.mp3"
        },
        {
          "id": "03",
          "speaker": "佐藤",
          "parts": [{ "t": "夜", "r": "よる" }, { "t": "は" }, { "t": "何時", "r": "なんじ" }, { "t": "に" }, { "t": "寝ます", "r": "ねます" }, { "t": "か" }, { "t": "。" }],
          "speech": "よるはなんじにねますか。",
          "zh": "晚上几点睡觉？",
          "audio": "03.mp3"
        },
        {
          "id": "04",
          "speaker": "周",
          "parts": [{ "t": "11時", "r": "じゅういちじ" }, { "t": "に" }, { "t": "寝ます", "r": "ねます" }, { "t": "。" }],
          "speech": "じゅういちじにねます。",
          "zh": "十一点睡觉。",
          "audio": "04.mp3"
        },
        {
          "id": "05",
          "speaker": "周",
          "parts": [{ "t": "佐藤", "r": "さとう" }, { "t": "さんも" }, { "t": "7時", "r": "しちじ" }, { "t": "に" }, { "t": "起きます", "r": "おきます" }, { "t": "か" }, { "t": "。" }],
          "speech": "さとうさんもしちじにおきますか。",
          "zh": "佐藤也是七点起床吗？",
          "audio": "05.mp3"
        },
        {
          "id": "06",
          "speaker": "佐藤",
          "parts": [{ "t": "いいえ" }, { "t": "、" }, { "t": "6時", "r": "ろくじ" }, { "t": "に" }, { "t": "起きます", "r": "おきます" }, { "t": "。" }],
          "speech": "いいえ、ろくじにおきます。",
          "zh": "不，我六点起床。",
          "audio": "06.mp3"
        }
      ],
      "grammar": [
        {
          "pattern": "何時に起きますか",
          "zh": "问几点做某事。时间后面用に。动词用ます形。",
          "example": [{ "t": "何時", "r": "なんじ" }, { "t": "に" }, { "t": "起きます", "r": "おきます" }, { "t": "か" }, { "t": "。" }]
        },
        {
          "pattern": "7時に起きます",
          "zh": "回答时先说时间，再说动作。",
          "example": [{ "t": "7時", "r": "しちじ" }, { "t": "に" }, { "t": "起きます", "r": "おきます" }, { "t": "。" }]
        }
      ],
      "words": [
        { "parts": [{ "t": "起きます", "r": "おきます" }], "zh": "起床" },
        { "parts": [{ "t": "寝ます", "r": "ねます" }], "zh": "睡觉" },
        { "parts": [{ "t": "何時", "r": "なんじ" }], "zh": "几点" },
        { "parts": [{ "t": "7時", "r": "しちじ" }], "zh": "七点" },
        { "parts": [{ "t": "6時", "r": "ろくじ" }], "zh": "六点" },
        { "parts": [{ "t": "11時", "r": "じゅういちじ" }], "zh": "十一点" },
        { "parts": [{ "t": "夜", "r": "よる" }], "zh": "晚上" }
      ]
    },
    {
      "id": "2",
      "label": "第二则",
      "title": "每天在公司工作",
      "scene": "佐藤说自己的上班时间，再问你今天上不上班。",
      "lines": [
        {
          "id": "07",
          "speaker": "佐藤",
          "parts": [{ "t": "私", "r": "わたし" }, { "t": "は" }, { "t": "毎日", "r": "まいにち" }, { "t": "会社", "r": "かいしゃ" }, { "t": "で" }, { "t": "働きます", "r": "はたらきます" }, { "t": "。" }],
          "speech": "わたしはまいにちかいしゃではたらきます。",
          "zh": "我每天在公司工作。",
          "audio": "07.mp3"
        },
        {
          "id": "08",
          "speaker": "佐藤",
          "parts": [{ "t": "8時", "r": "はちじ" }, { "t": "に" }, { "t": "会社", "r": "かいしゃ" }, { "t": "で" }, { "t": "働きます", "r": "はたらきます" }, { "t": "。" }],
          "speech": "はちじにかいしゃではたらきます。",
          "zh": "八点在公司工作。",
          "audio": "08.mp3"
        },
        {
          "id": "09",
          "speaker": "佐藤",
          "parts": [{ "t": "周", "r": "しゅう" }, { "t": "さんも" }, { "t": "毎日", "r": "まいにち" }, { "t": "働きます", "r": "はたらきます" }, { "t": "か" }, { "t": "。" }],
          "speech": "しゅうさんもまいにちはたらきますか。",
          "zh": "小周也是每天工作吗？",
          "audio": "09.mp3"
        },
        {
          "id": "10",
          "speaker": "周",
          "parts": [{ "t": "はい" }, { "t": "、" }, { "t": "毎日", "r": "まいにち" }, { "t": "働きます", "r": "はたらきます" }, { "t": "。" }],
          "speech": "はい、まいにちはたらきます。",
          "zh": "是，每天工作。",
          "audio": "10.mp3"
        },
        {
          "id": "11",
          "speaker": "佐藤",
          "parts": [{ "t": "今日", "r": "きょう" }, { "t": "は" }, { "t": "休みます", "r": "やすみます" }, { "t": "か" }, { "t": "。" }],
          "speech": "きょうはやすみますか。",
          "zh": "今天休息吗？",
          "audio": "11.mp3"
        },
        {
          "id": "12",
          "speaker": "周",
          "parts": [{ "t": "いいえ" }, { "t": "、" }, { "t": "休みません", "r": "やすみません" }, { "t": "。" }],
          "speech": "いいえ、やすみません。",
          "zh": "不，不休息。",
          "audio": "12.mp3"
        }
      ],
      "grammar": [
        {
          "pattern": "会社で働きます",
          "zh": "で表示动作发生的地方。在公司工作，用で。",
          "example": [{ "t": "会社", "r": "かいしゃ" }, { "t": "で" }, { "t": "働きます", "r": "はたらきます" }, { "t": "。" }]
        },
        {
          "pattern": "休みません",
          "zh": "ます的否定是ません。不休息，说休みません。",
          "example": [{ "t": "休みません", "r": "やすみません" }, { "t": "。" }]
        }
      ],
      "words": [
        { "parts": [{ "t": "毎日", "r": "まいにち" }], "zh": "每天" },
        { "parts": [{ "t": "会社", "r": "かいしゃ" }], "zh": "公司" },
        { "parts": [{ "t": "働きます", "r": "はたらきます" }], "zh": "工作" },
        { "parts": [{ "t": "休みます", "r": "やすみます" }], "zh": "休息" },
        { "parts": [{ "t": "今日", "r": "きょう" }], "zh": "今天" },
        { "parts": [{ "t": "8時", "r": "はちじ" }], "zh": "八点" },
        { "parts": [{ "t": "で" }], "zh": "在（某个地方做事情）" }
      ]
    },
    {
