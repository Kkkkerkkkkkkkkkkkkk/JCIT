        {
          "id": "16",
          "speaker": "周",
          "parts": [{ "t": "いいえ" }, { "t": "、" }, { "t": "昼", "r": "ひる" }, { "t": "は" }, { "t": "勉強しません", "r": "べんきょうしません" }, { "t": "。" }],
          "speech": "いいえ、ひるはべんきょうしません。",
          "zh": "不，中午不学习。",
