      "id": "1",
      "label": "第一则",
      "title": "这里是前台",
      "scene": "佐藤带你看公司。他一边走，一边告诉你每个地方是什么。",
      "lines": [
        {
          "id": "01",
          "speaker": "佐藤",
          "parts": [{ "t": "ここ" }, { "t": "は" }, { "t": "受付", "r": "うけつけ" }, { "t": "です" }, { "t": "。" }],
          "speech": "ここはうけつけです。",
          "zh": "这里是前台。",
          "audio": "01.mp3"
        },
        {
          "id": "02",
          "speaker": "佐藤",
          "parts": [{ "t": "そこ" }, { "t": "は" }, { "t": "事務所", "r": "じむしょ" }, { "t": "です" }, { "t": "。" }],
          "speech": "そこはじむしょです。",
          "zh": "那里是办公室。",
          "audio": "02.mp3"
        },
        {
          "id": "03",
          "speaker": "佐藤",
          "parts": [{ "t": "あそこ" }, { "t": "は" }, { "t": "食堂", "r": "しょくどう" }, { "t": "です" }, { "t": "。" }],
          "speech": "あそこはしょくどうです。",
          "zh": "那边是食堂。",
          "audio": "03.mp3"
        },
        {
          "id": "04",
          "speaker": "周",
          "parts": [{ "t": "会議室", "r": "かいぎしつ" }, { "t": "は" }, { "t": "どこ" }, { "t": "ですか" }, { "t": "。" }],
          "speech": "かいぎしつはどこですか。",
          "zh": "会议室在哪儿？",
          "audio": "04.mp3"
        },
        {
          "id": "05",
          "speaker": "佐藤",
          "parts": [{ "t": "あそこ" }, { "t": "です" }, { "t": "。" }],
          "speech": "あそこです。",
          "zh": "在那边。",
          "audio": "05.mp3"
