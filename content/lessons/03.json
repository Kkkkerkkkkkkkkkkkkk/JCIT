          "speech": "いいえ、しょくどうはあちらです。",
          "zh": "不，食堂在那边。",
          "audio": "09.mp3"
        },
        {
          "id": "10",
          "speaker": "周",
          "parts": [{ "t": "事務所", "r": "じむしょ" }, { "t": "は" }, { "t": "どこ" }, { "t": "ですか" }, { "t": "。" }],
          "speech": "じむしょはどこですか。",
          "zh": "办公室在哪儿？",
          "audio": "10.mp3"
        },
        {
          "id": "11",
          "speaker": "佐藤",
          "parts": [{ "t": "ここ" }, { "t": "です" }, { "t": "。" }],
          "speech": "ここです。",
          "zh": "就在这里。",
          "audio": "11.mp3"
        }
