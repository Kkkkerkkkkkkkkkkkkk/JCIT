      "grammar": [
        {
          "pattern": "こちら / そちら / あちら",
          "zh": "和ここ、そこ、あそこ一样指方向，说法更客气。给别人指路时常用。",
          "example": [{ "t": "トイレ" }, { "t": "は" }, { "t": "こちら" }, { "t": "です" }, { "t": "。" }]
        }
      ],
      "words": [
        { "parts": [{ "t": "こちら" }], "zh": "这边" },
        { "parts": [{ "t": "そちら" }], "zh": "那边（你那边）" },
        { "parts": [{ "t": "あちら" }], "zh": "那边（更远）" },
        { "parts": [{ "t": "トイレ" }], "zh": "厕所" }
