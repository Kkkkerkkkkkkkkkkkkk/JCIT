        {
          "pattern": "どこですか",
          "zh": "问某个地方在哪儿。",
          "example": [{ "t": "会議室", "r": "かいぎしつ" }, { "t": "は" }, { "t": "どこ" }, { "t": "ですか" }, { "t": "。" }]
